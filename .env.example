# PhrydlPG Production Environment Configuration

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=phrydlpg
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Generate a secure 256-bit+ base64 key
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# Infrastructure (MinIO / S3 Storage)
# -----------------------------------------------------------------------------
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=YOUR_SECURE_MINIO_SECRET
MINIO_BUCKET=phrydlpg-assets

# -----------------------------------------------------------------------------
# Financial Integrations (Razorpay)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=YOUR_PRODUCTION_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_PRODUCTION_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_PRODUCTION_WEBHOOK_SECRET

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=YOUR_SMTP_API_KEY
SMTP_FROM=no-reply@phrydlpg.com

# -----------------------------------------------------------------------------
# Application Networking
# -----------------------------------------------------------------------------
PORT=8080
CORS_ALLOWED_ORIGINS=https://app.phrydlpg.com
